{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "arrowParens": "avoid",
  "bracketSameLine": false,
  "bracketSpacing": true,
  "endOfLine": "lf",
  "ignorePatterns": ["**/.git", "**/assets/public/assets", "**/out-tsc", "**/routeTree.gen.ts", "**/storybook-static", "**/test-output", "**/types/**/*.d.ts", "**/.storybook/tw.css"],
  "objectWrap": "preserve",
  "printWidth": 240,
  "quoteProps": "as-needed",
  "semi": false,
  "singleAttributePerLine": false,
  "singleQuote": true,
  "sortImports": {
    "ignoreCase": true,
    "newlinesBetween": false,
  },
  "sortPackageJson": false,
  "sortTailwindcss": {
    "functions": ["clsx", "cn", "cva", "tw"],
    "preserveDuplicates": false,
    "preserveWhitespace": false,
    "stylesheet": "./src/index.css",
  },
  "tabWidth": 2,
  "trailingComma": "all",
  "useTabs": false,
}
