{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "lint:install": {
      "inputs": ["package.json", "pnpm-lock.yaml", "pnpm-workspace.yaml"]
    },
    "build:tsc": {
      "dependsOn": ["lint:install"]
    },
    "build:vite": {
      "dependsOn": ["build:tsc"],
      "outputs": ["dist/**"]
    },
    "lint:types": {
      "dependsOn": ["lint:install"]
    },
    "lint:format": {
      "dependsOn": ["lint:install"]
    },
    "lint:fallow": {
      "dependsOn": ["lint:install"]
    },
    "lint:issues": {
      "dependsOn": ["lint:install"]
    },
    "lint:knip": {
      "dependsOn": ["lint:install"]
    },
    "lint:repo": {
      "dependsOn": ["build:vite"],
      "inputs": ["$TURBO_DEFAULT$", "dist/**"]
    },
    "test:unit": {
      "dependsOn": ["lint:install"],
      "outputs": ["coverage/**"]
    },
    "test:e2e": {
      "dependsOn": ["lint:install"],
      "outputs": ["playwright-report/**", "test-results/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "start:proxy": {
      "cache": false,
      "persistent": true
    },
    "start:vite": {
      "cache": false,
      "persistent": true
    }
  }
}
